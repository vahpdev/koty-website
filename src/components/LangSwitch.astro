---
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<nav class="lang-switch" aria-label={isEs ? 'Idioma' : 'Language'}>
  <a href="/" aria-current={isEs ? 'page' : undefined} aria-label={isEs ? 'Español' : 'Spanish'}>ES</a>
  <a href="/en/" aria-current={!isEs ? 'page' : undefined} aria-label={isEs ? 'Inglés' : 'English'}>EN</a>
</nav>
